# Public Supabase client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side operations only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres connection for migration status/baseline/apply.
# Copy the URI from your own Supabase project's Connect panel.
DATABASE_URL=
# Optional PEM contents when the local Postgres server uses a custom CA.
DATABASE_SSL_CA=

# One-time, read-only production source for local cases seeding.
# Remove both values from .env.local after the import.
PROD_SUPABASE_URL=
PROD_SUPABASE_ANON_KEY=

# Internal operator access
GOODCASE_OPERATOR_USER_ID=
GOODCASE_OPERATOR_PASSWORD=
GOODCASE_OPERATOR_SESSION_SECRET=

# Owner notifications
GOODCASE_OWNER_WEBHOOK_URL=
GOODCASE_OWNER_WEBHOOK_FORMAT=feishu

# Public site origin
NEXT_PUBLIC_SITE_URL=https://goodcase.ai
SITE_URL=https://goodcase.ai
GOODCASE_CANONICAL_ORIGIN=https://goodcase.ai

# Keep false until the replacement domain has passed filing, DNS, HTTPS,
# real-device WeChat checks, and the required stability window.
GOODCASE_ENABLE_LEGACY_REDIRECT=false

# Pin the homepage featured case to one slug. Leave empty to use the newest
# published case, which changes every time a new case goes live.
GOODCASE_FEATURED_CASE_SLUG=

# Supply discovery and enrichment
RADAR_FEED_URL=
YOUMIND_INDEX_URL=https://youmind.com/zh-CN/prompts
SOCIALDATA_API_KEY=
SUPPLY_SOURCE=
SUPPLY_MAX_ITEMS=

# Optional local media enrichment
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=

# Required only when generating new installable Skills
SKILL_CREATOR_ROOT=
