{
  "name": "goodcaseai-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/supply/lib/*.test.mjs scripts/review/lib/*.test.mjs scripts/ops/lib/*.test.mjs",
    "supply:shadow": "node scripts/supply/shadow-run.mjs",
    "supply:youmind": "node scripts/supply/shadow-run.mjs --source=youmind --max-items=8",
    "analyze:local-media": "node scripts/supply/enrich-local-media.mjs",
    "ops:inbox": "node --env-file=.env.local scripts/operator-inbox.mjs",
    "ops:reconcile": "node --env-file=.env.local scripts/ops/reconcile-production-data.mjs",
    "ops:domain-ready": "node scripts/ops/check-domain-readiness.mjs",
    "import:candidates": "node scripts/ingest-candidates.mjs",
    "review:candidates": "node scripts/review-candidates.mjs",
    "publish:cases": "node scripts/publish-approved-cases.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
