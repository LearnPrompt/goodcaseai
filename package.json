{
  "name": "goodcaseai-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/supply/lib/*.test.mjs scripts/review/lib/*.test.mjs scripts/ops/lib/*.test.mjs scripts/retest/lib/*.test.mjs",
    "supply:shadow": "node scripts/supply/shadow-run.mjs",
    "supply:youmind": "node scripts/supply/shadow-run.mjs --source=youmind --max-items=8",
    "supply:multisource": "node scripts/supply/collect-alternative-samples.mjs",
    "supply:prepare-multisource": "node scripts/supply/prepare-source-candidates.mjs",
    "analyze:local-media": "node scripts/supply/enrich-local-media.mjs",
    "ops:inbox": "node --env-file=.env.local scripts/operator-inbox.mjs",
    "ops:backup-data": "node --env-file=.env.local scripts/ops/backup-candidate-data.mjs",
    "ops:map-human-reviews": "node --env-file=.env.local scripts/ops/apply-human-review-labels.mjs",
    "ops:reconcile": "node --env-file=.env.local scripts/ops/reconcile-production-data.mjs",
    "ops:domain-ready": "node scripts/ops/check-domain-readiness.mjs",
    "ops:i18n-smoke": "node scripts/ops/check-i18n-pages.mjs",
    "ops:translate-cases": "node --env-file=.env.local scripts/ops/backfill-case-translations.mjs",
    "ops:creator-avatars": "node --env-file=.env.local scripts/ops/backfill-creator-avatars.mjs",
    "ops:migrate": "node --env-file=.env.local scripts/ops/migrate.mjs",
    "dev:seed": "node --env-file=.env.local scripts/dev-seed.mjs",
    "skills:generate": "node --env-file=.env.local scripts/skills/generate-installable-skills.mjs",
    "daily:digest": "node --env-file=.env.local scripts/daily/build-digest.mjs",
    "api-keys": "node --env-file=.env.local scripts/api-keys/issue.mjs",
    "import:candidates": "node --env-file=.env.local scripts/ingest-candidates.mjs",
    "review:candidates": "node --env-file=.env.local scripts/review-candidates.mjs",
    "publish:cases": "node --env-file=.env.local scripts/publish-approved-cases.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.101.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^2.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
